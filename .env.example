# ==============================================================================
# MERGEIT AI - ENVIRONMENT VARIABLES FOR VERCEL
# Add these in: Vercel Project Settings -> Environment Variables
# ==============================================================================

# Razorpay LIVE Credentials (from your Razorpay dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Brevo SMTP Mail Relay Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login_here
SMTP_PASSWORD=your_brevo_smtp_master_password_here
EMAIL_FROM=support@clutchpad.in
EMAIL_FROM_NAME=MergeIt AI Official

# Google Apps Script Master Licensing Endpoint
GOOGLE_SHEET_SCRIPT_URL=your_google_sheet_script_url_here

# Optional: Direct Download Link for MergeIt-AI-v1.0.zip
APP_DOWNLOAD_URL=https://mergeit.in/downloads/MergeIt-AI-v1.0.zip
